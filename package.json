{
  "name": "perfect-racket",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-issues.mjs",
    "preview": "vite preview",
    "test:scoring": "node test-scoring.mjs",
    "test:report": "node --import ./test/register.mjs test/generate-report.test.mjs",
    "test:genfail": "node --import ./test/register.mjs test/genfail-stats.test.mjs",
    "test:results": "node test/results-render.test.mjs",
    "test:tension": "node test/tension.test.mjs",
    "test:blanksw": "node test/blank-sw.test.mjs",
    "test:armfriendly": "node test/arm-friendly.test.mjs",
    "test:utm": "node test/utm.test.mjs",
    "test": "npm run test:report && npm run test:genfail && npm run test:results && npm run test:tension && npm run test:scoring"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.2"
  }
}
